<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <!-- External checkouts this repo builds against. Override on the command line or in
         Directory.Build.local.props (ignored by git) when they live somewhere else. -->
    <EngineRoot Condition="'$(EngineRoot)' == ''">$(USERPROFILE)\youradventure\Old Engine</EngineRoot>
    <BiologyLibRoot Condition="'$(BiologyLibRoot)' == ''">$(USERPROFILE)\BiologyLib</BiologyLibRoot>
  </PropertyGroup>

  <Import Project="Directory.Build.local.props" Condition="Exists('Directory.Build.local.props')" />
</Project>
