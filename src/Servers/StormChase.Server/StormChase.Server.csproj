<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EngineRoot Condition="'$(EngineRoot)' == ''">C:\Users\reviv\youradventure\Old Engine</EngineRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <ProjectReference Include="$(EngineRoot)\src\Engine.Environment\Engine.Environment.csproj" />
    <ProjectReference Include="$(EngineRoot)\src\Engine.Rendering\Engine.Rendering.csproj" />
    <ProjectReference Include="$(EngineRoot)\src\Engine.CrestWater\Engine.CrestWater.csproj" />
    <ProjectReference Include="$(EngineRoot)\src\Engine.Paths\Engine.Paths.csproj" />
    <ProjectReference Include="$(EngineRoot)\src\Engine.Splines\Engine.Splines.csproj" />
    <ProjectReference Include="$(EngineRoot)\src\Engine.Physics.PhysX\Engine.Physics.PhysX.csproj" />
    <ProjectReference Include="..\..\Shared\StormChase.Networking\StormChase.Networking.csproj" />
    <ProjectReference Include="..\..\Shared\LifeCare.Construction\LifeCare.Construction.csproj" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseCampaignWeather.cs" Link="Weather\StormChaseCampaignWeather.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseAtmosphere.cs" Link="Weather\StormChaseAtmosphere.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseCoast.cs" Link="World\StormChaseCoast.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseStormFields.cs" Link="Weather\StormChaseStormFields.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseVortexFields.cs" Link="Weather\StormChaseVortexFields.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseContracts.cs" Link="Gameplay\StormChaseContracts.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseContracts.Jobs.cs" Link="Gameplay\StormChaseContracts.Jobs.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseJobs.cs" Link="Gameplay\StormChaseJobs.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseHousing.cs" Link="Gameplay\StormChaseHousing.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseFurniturePhysics.cs" Link="Gameplay\StormChaseFurniturePhysics.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\LiveStormController.cs" Link="Weather\LiveStormController.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseWorld.cs" Link="World\StormChaseWorld.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseWorldMap.cs" Link="World\StormChaseWorldMap.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseWorldSpatial.cs" Link="World\StormChaseWorldSpatial.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseWorldFingerprint.cs" Link="World\StormChaseWorldFingerprint.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseTerrainGeometry.cs" Link="World\StormChaseTerrainGeometry.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseInteriors.cs" Link="World\StormChaseInteriors.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseModelLibrary.cs" Link="World\StormChaseModelLibrary.cs" />
    <Compile Include="..\..\Client\PmWeather.Showcase\StormChaseModelInteriors.cs" Link="World\StormChaseModelInteriors.cs" />
