  </ItemGroup>
  <ItemGroup>
    <Content Include="$(StormChaseAssetsRoot)\StormChase\Models\*.json" Link="Assets\StormChase\Models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(StormChaseAssetsRoot)\StormChase\Models\weathered-brick.png" Link="Assets\StormChase\Models\weathered-brick.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(StormChaseAssetsRoot)\StormChase\Textures\*.png" Link="Assets\StormChase\Textures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyVerifiedPhysicsRuntime" AfterTargets="Build;Publish" Condition="'$(EnginePhysicsRuntime)' != ''">
    <Copy SourceFiles="$(EnginePhysicsRuntime)" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="$(EnginePhysicsRuntime)" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
